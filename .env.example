# ===========================================================================
# Copy to .env.local and fill in. .env.local is git-ignored; never commit a
# key. Every variable here is optional — with none of them set the terminal
# still runs, sourcing crypto from Binance and everything else from Yahoo,
# both of which are keyless.
# ===========================================================================

# Finnhub (finnhub.io/register — free tier: 60 calls/min).
# Unlocks US equity and ETF quotes, company fundamentals, earnings dates,
# insider transactions, and the symbol search that lets the command bar
# reach securities outside the curated universe.
FINNHUB_API_KEY=

# CoinGecko (coingecko.com/en/api — optional).
# Only needed for the paid tiers; the keyless public endpoint works and is
# the second crypto source after Binance.
COINGECKO_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact details, or it
# blocks the request. Set this to use Form 4 (insider) and 13F (institutional)
# filings as a primary source.
# SEC_USER_AGENT="Your Name your.email@example.com"
SEC_USER_AGENT=

# Seconds to hold a provider response in the in-process cache. Lower means
# fresher figures and more vendor calls; the free tiers are rate-limited, so
# do not set this to 0 on a multi-user deployment.
MERIDIAN_CACHE_TTL=45

# Set to 1 to forbid every outbound call and run entirely on the deterministic
# simulator. Useful for demos and for tests that must not touch the network.
MERIDIAN_OFFLINE=
