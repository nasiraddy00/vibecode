# ---------------------------------------------------------------------------
# Meridian Terminal - data provider credentials
# ---------------------------------------------------------------------------
# Every key is OPTIONAL. The terminal degrades gracefully: any feed without a
# key (or unreachable) is served by the deterministic simulator and clearly
# badged SIM in the UI. Nothing is ever silently faked.
#
# Copy to .env.local and fill in whichever you have.

# --- Equities: quotes, OHLCV, fundamentals, earnings -----------------------
# Free tier: 60 req/min. https://finnhub.io
FINNHUB_API_KEY=
# Free tier: 25 req/day. https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# Paid. Best options-chain + IV data. https://polygon.io
POLYGON_API_KEY=
# Free tier available. https://fmpcloud.io
FMP_API_KEY=
# Free tier: 800 req/day, good fundamentals. https://twelvedata.com
TWELVEDATA_API_KEY=

# --- Crypto ---------------------------------------------------------------
# Binance & CoinGecko public endpoints need no key; a CoinGecko Pro key
# raises rate limits.
COINGECKO_API_KEY=

# --- News / media ---------------------------------------------------------
# https://newsapi.org (free dev tier)
NEWSAPI_KEY=
# https://gnews.io
GNEWS_API_KEY=

# --- Social sentiment -----------------------------------------------------
# Reddit script app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X/Twitter v2 bearer token (paid tiers only)
X_BEARER_TOKEN=

# --- SEC EDGAR (insider Form 4 / institutional 13F) -----------------------
# No key needed, but SEC requires a descriptive User-Agent with contact info.
SEC_USER_AGENT="Meridian Terminal research/1.0 (your-email@example.com)"

# --- Runtime behaviour ----------------------------------------------------
# When 1, never attempt network calls; run fully on the simulator. Useful for
# demos, CI, and sandboxes with restricted egress.
MERIDIAN_OFFLINE=0
# Seconds to cache provider responses in-process.
MERIDIAN_CACHE_TTL=45
